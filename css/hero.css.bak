/* ══════════════════════════════════════════════════════════════════
   AMBI — HERO.CSS
══════════════════════════════════════════════════════════════════ */


/* ──────────────────────────────────────────
   HERO — CONTENEDOR
────────────────────────────────────────── */

.hero {
    aspect-ratio: 1920 / 700;
    min-height: unset;
}


/* ──────────────────────────────────────────
   HERO — FONDO
────────────────────────────────────────── */

.hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('../imgs/index/bgs/ta-lunaabyss.jpg');
    opacity: .5;
    background-size: cover;
    background-position: center center;
    z-index: 1;
}


/* ──────────────────────────────────────────
   HERO — IMAGEN OVERFLOW
   Centrada, arranca desde el top
────────────────────────────────────────── */

.hero-ovimg {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 35%;
    transform: translateX(-50%);
    width: auto;
    max-width: 100%;
    z-index: 2;
    pointer-events: none;
}

.hero-ovimg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}


/* ──────────────────────────────────────────
   HERO — LOGO DEL JUEGO
   Centrado, debajo del nav
────────────────────────────────────────── */

.hero-logo {
    position: absolute;
    top: 40%;
    left: 65%;
    transform: translateX(-50%);
    width: 600px;
    max-width: 70%;
    z-index: 3;
    pointer-events: none;
}

.hero-logo img {
    width: 100%;
    height: auto;
    display: block;
}