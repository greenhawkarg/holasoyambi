<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>AMBI</title>

    <!-- FONTS -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet">

    <!-- ICONS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <!-- CSS GLOBAL -->
    <link rel="stylesheet" href="css/style.css">

    <!-- CSS POR SECCIÓN -->
    <link rel="stylesheet" href="css/nav.css">
    <link rel="stylesheet" href="css/hero.css">
    <link rel="stylesheet" href="css/agenda.css">
    <link rel="stylesheet" href="css/twitch.css">
    <link rel="stylesheet" href="css/noticias.css">
    <link rel="stylesheet" href="css/spotify.css">

</head>

<body>


    <!-- ══════════════════════════════════════════════
    NAV — MENÚ FLOTANTE FIJO
    ══════════════════════════════════════════════ -->

    <nav class="nav" id="nav">

        <a class="nav-home" href="#hero">
            <i class="fas fa-home"></i>
        </a>

        <ul class="nav-links">
            <li><a href="#agenda">Agenda</a></li>
            <li><a href="#noticias">Noticias</a></li>
            <li><a href="#twitch">Twitch</a></li>
        </ul>

        <ul class="nav-social">
            <li><a href="#" target="_blank"><i class="fab fa-twitch"></i></a></li>
            <li><a href="#" target="_blank"><i class="fab fa-youtube"></i></a></li>
            <li><a href="#" target="_blank"><i class="fab fa-instagram"></i></a></li>
            <li><a href="#" target="_blank"><i class="fab fa-discord"></i></a></li>
            <li><a href="#" target="_blank"><i class="fab fa-x-twitter"></i></a></li>
            <li><a href="#" target="_blank"><i class="fab fa-spotify"></i></a></li>
        </ul>

    </nav>


    <!-- ══════════════════════════════════════════════
    SECTION — HERO
    ══════════════════════════════════════════════ -->

    <section class="hero" id="hero">
        <div class="hero-bg"></div>
        <div class="hero-ovimg">
            <img src="imgs/index/bg_temp_game_hero.png" alt="">
        </div>
        <div class="hero-logo">
            <img src="imgs/index/bg_temp_game-logo.png" alt="">
        </div>
    </section>


    <!-- ══════════════════════════════════════════════
    SECTION — AGENDA
    ══════════════════════════════════════════════ -->

    <section class="agenda" id="agenda">

        <div class="agenda-inner">

            <div class="agenda-left">
                <span class="agenda-kicker">AGENDA</span>
                <h2 class="agenda-title">DYING LIGHT: THE BEAST</h2>
                <div class="agenda-thumb">
                    <img src="imgs/index/agenda/ta-dltb.jpg" alt="Imagen del juego">
                </div>
            </div>

            <div class="agenda-info">
                <span class="agenda-badge">CAMPAÑA</span>
                <p class="agenda-desc">Kyle Crane regresa en una aventura de mundo abierto que mezcla parkour, supervivencia y terror en un entorno rural devastado.</p>
                <p class="agenda-fecha">DOMINGO 24 DE MAYO — 15:00HS</p>
                <a class="agenda-btn" href="#">VER AGENDA</a>
            </div>

        </div>

    </section>


    <!-- ══════════════════════════════════════════════
    SECTION — NOTICIAS
    ══════════════════════════════════════════════ -->

    <section class="noticias" id="noticias">

        <div class="noticias-inner">
            <div class="noticias-grid">

                <!-- ── COLUMNA IZQUIERDA: lista chica ── -->
                <div>
                    <div class="noticias-col-header">Otras novedades</div>
                    <div class="noticias-list" id="noticias-list"></div>
                </div>

                <!-- ── COLUMNA DERECHA: featured ── -->
                <div>
                    <div class="noticias-col-header">Noticia destacada</div>
                    <div class="noticias-featured">

                        <div class="noticias-featured-imgwrap">
                            <img id="noticias-featured-img" src="" alt="">
                            <div class="noticias-featured-body">
                                <div class="noticias-featured-meta">
                                    <span class="noticias-badge" id="noticias-featured-badge"></span>
                                    <span class="noticias-featured-fecha" id="noticias-featured-fecha"></span>
                                </div>
                                <div class="noticias-featured-title" id="noticias-featured-title"></div>
                                <div class="noticias-featured-desc" id="noticias-featured-desc"></div>
                                <div class="noticias-dots" id="noticias-dots"></div>
                            </div>
                            <button class="noticias-arrow prev" id="noticias-prev">&#8249;</button>
                            <button class="noticias-arrow next" id="noticias-next">&#8250;</button>
                        </div>

                    </div>
                </div>

            </div>
        </div>

    </section>


    <!-- ══════════════════════════════════════════════
    SECTION — TWITCH
    ══════════════════════════════════════════════ -->

    <section class="twitch" id="twitch">

        <div class="twitch-inner">

            <!-- PLAYER — columna izquierda -->
            <div class="twitch-player">

                <div class="twitch-player-embed">
                    <iframe
                        src="https://player.twitch.tv/?channel=4mbitv&parent=localhost"
                        frameborder="0"
                        allowfullscreen
                        scrolling="no">
                    </iframe>
                </div>

                <div class="twitch-player-bar">
                    <span class="twitch-stream-title">// ESTATE ATENTO A LA AGENDA PARA EL PRÓXIMO STREAM</span>
                    <span class="twitch-player-logo">
                        <i class="fab fa-twitch"></i> Twitch
                    </span>
                </div>

            </div>

            <!-- PANEL INFO — columna derecha -->
            <div class="twitch-panel">

                <div class="twitch-vod-embed"></div>

                <span class="twitch-kicker">ÚLTIMO STREAM</span>
                <span class="twitch-channel-name">4MBITV</span>

                <div class="twitch-status">
                    <span class="twitch-status-dot offline"></span>
                    <span class="twitch-status-label offline">OFFLINE</span>
                </div>

                <p class="twitch-desc">Seguí el stream en vivo. Gameplays y contenido exclusivo.</p>

                <a class="twitch-btn" href="https://twitch.tv/4mbitv" target="_blank">
                    VER EN TWITCH
                </a>

            </div>

        </div>

    </section>


    <!-- ══════════════════════════════════════════════
    SECTION — SPOTIFY
    ══════════════════════════════════════════════ -->

    <section class="spotify" id="spotify">
        <div class="spotify-inner">
            <div class="spotify-left">
                <i class="fab fa-spotify"></i>
                <span>No te olvides de escuchar mis temas en Spotify</span>
            </div>
            <a class="spotify-btn" href="https://open.spotify.com/intl-es/artist/64VR4resIiyFchXF9FCLGd?si=nzkdIBTnSWOOcw-oJPtPSw" target="_blank">
                ESCUCHAR EN SPOTIFY
            </a>
        </div>
    </section>


    <!-- ══════════════════════════════════════════════
    BLEEDS — ELEMENTOS FLOTANTES ENTRE SECCIONES
    Posicionados via bleeds.js
    ══════════════════════════════════════════════ -->

    <!-- AGENDA -->
    <div class="bleed bleed-agenda-top">
        <img src="imgs/index/agenda/agenda_over-img.webp" alt="">
    </div>

    <!-- TWITCH -->
    <div class="bleed bleed-twitch-left">
        <img src="imgs/index/overflow/ambi_twitch.webp" alt="">
    </div>


    <!-- ══════════════════════════════════════════════
    JS POR SECCIÓN
    ══════════════════════════════════════════════ -->

    <script src="js/bleeds.js"></script>
    <script src="js/menu.js"></script>
    <script src="js/hero.js"></script>
    <script src="js/agenda.js"></script>
    <script src="js/twitch-vod.js"></script>
    <script src="js/noticias.js"></script>

</body>
</html>